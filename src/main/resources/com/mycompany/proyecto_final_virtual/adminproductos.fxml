<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.AdminProductosController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #1A56DB; -fx-padding: 12 20 12 20;">
         <children>
            <Label text="UniShop · Administración de productos" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="16.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsuario" textFill="WHITE" />
            <Button fx:id="btnPedidos" mnemonicParsing="false" style="-fx-background-color: #EBF5FF; -fx-background-radius: 8; -fx-text-fill: #1A56DB;" text="Pedidos pendientes" />
            <Button fx:id="btnSalir" mnemonicParsing="false" style="-fx-background-color: #EBF5FF; -fx-background-radius: 8; -fx-text-fill: #1A56DB;" text="Salir" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <VBox prefWidth="280.0" spacing="8.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-padding: 16;">
               <children>
                  <Label text="Nuevo producto / editar">
                     <font>
                        <Font name="Segoe UI Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Nombre">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtNombre" promptText="Ej: Audífonos Bluetooth" />
                  <Label text="Cantidad en stock">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtCantidad" promptText="Ej: 10" />
                  <Label text="Valor unitario">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtValor" promptText="Ej: 129900" />
                  <Label text="Categoría">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbCategoria" maxWidth="Infinity" />
                  <Button fx:id="btnAgregar" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: #1A56DB; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 6;" text="Agregar producto" />
                  <Button fx:id="btnEditar" maxWidth="Infinity" mnemonicParsing="false" text="Guardar cambios" />
                  <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="false" text="Eliminar seleccionado" />
                  <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="false" text="Limpiar formulario" />
               </children>
            </VBox>
            <TableView fx:id="tblProductos" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="300.0" text="Producto" />
                  <TableColumn fx:id="colCategoria" prefWidth="140.0" text="Categoría" />
                  <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Stock" />
                  <TableColumn fx:id="colValor" prefWidth="140.0" text="Valor" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </HBox>
   </center>
</BorderPane>
