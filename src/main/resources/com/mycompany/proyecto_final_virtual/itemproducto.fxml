<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="260.0" prefWidth="250.0" spacing="8.0" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #E5E7EB;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <ImageView fx:id="imgProducto" fitHeight="120.0" fitWidth="225.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="lblNombre" text="Nombre del producto">
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Label>
      <Label fx:id="lblPrecio" text="\$ 0">
         <font>
            <Font name="Segoe UI Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblStock" text="Stock: 0 uds." textFill="#10b981">
         <font>
            <Font name="Segoe UI" size="11.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="btnAgregarCarrito" mnemonicParsing="false" style="-fx-background-color: #1A56DB; -fx-background-radius: 8; -fx-padding: 6 12 6 12;" text="Agregar al carrito" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="11.0" />
               </font>
            </Button>
            <Button fx:id="btnAgregarDeseos" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 6 10 6 10;" text="+ Deseos" textFill="#374151">
               <font>
                  <Font name="Segoe UI" size="11.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
