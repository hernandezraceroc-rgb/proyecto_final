<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.DeseosController">
   <top>
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1A56DB; -fx-padding: 12 20 12 20;">
         <children>
            <Label text="UniShop · Lista de deseos" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="16.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="12.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <TableView fx:id="tblDeseos" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="350.0" text="Producto" />
                  <TableColumn fx:id="colCategoria" prefWidth="160.0" text="Categoría" />
                  <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio" />
                  <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnPasar" mnemonicParsing="false" style="-fx-background-color: #1A56DB; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 6 12 6 12;" text="Pasar al carrito" />
                  <Button fx:id="btnQuitar" mnemonicParsing="false" text="Quitar de deseos" />
                  <Button fx:id="btnVolver" mnemonicParsing="false" text="Volver al catálogo" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
