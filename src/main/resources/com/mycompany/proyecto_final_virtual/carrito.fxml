<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.CarritoController">
   <top>
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1A56DB; -fx-padding: 12 20 12 20;">
         <children>
            <Label text="UniShop · Carrito de compras" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="16.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <HBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <TableView fx:id="tblItems" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colProducto" prefWidth="300.0" text="Producto" />
                  <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio" />
                  <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
                  <TableColumn fx:id="colSubtotal" prefWidth="150.0" text="Subtotal" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <VBox prefWidth="270.0" spacing="10.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-padding: 16;">
               <children>
                  <Label text="Resumen">
                     <font>
                        <Font name="Segoe UI Bold" size="16.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Subtotal" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSubtotal" text="\$ 0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Envío" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblEnvio" text="\$ 0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Total" HBox.hgrow="ALWAYS">
                           <font>
                              <Font name="Segoe UI Bold" size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblTotal" text="\$ 0">
                           <font>
                              <Font name="Segoe UI Bold" size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox spacing="8.0">
                     <children>
                        <Button fx:id="btnMenos" mnemonicParsing="false" text="−" />
                        <Button fx:id="btnMas" mnemonicParsing="false" text="+" />
                        <Button fx:id="btnQuitar" mnemonicParsing="false" text="Quitar" />
                     </children>
                  </HBox>
                  <Button fx:id="btnDeshacer" mnemonicParsing="false" maxWidth="Infinity" text="Deshacer última acción" />
                  <Button fx:id="btnFinalizar" mnemonicParsing="false" maxWidth="Infinity" style="-fx-background-color: #1A56DB; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 8;" text="Finalizar compra">
                     <font>
                        <Font name="Segoe UI Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnVolver" mnemonicParsing="false" maxWidth="Infinity" text="Volver al catálogo" />
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
